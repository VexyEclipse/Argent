{
  "name": "argent",
  "private": true,
  "version": "0.1.0",
  "description": "A premium, cinematic media frontend.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "desktop": "vite build && electron .",
    "desktop:dev": "electron . --dev",
    "desktop:pack": "tsc --noEmit && vite build && electron-builder --win",
    "icons": "electron scripts/make-icons.cjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.3",
    "blurhash": "^2.0.5",
    "hls.js": "^1.7.4",
    "jassub": "^2.5.23",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^44.9.0",
    "electron-builder": "^26.17.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "main": "electron/main.cjs",
  "productName": "Argent",
  "author": "VexyEclipse",
  "build": {
    "appId": "com.vexyeclipse.argent",
    "productName": "Argent",
    "copyright": "Logo artwork © Jellyfin contributors, CC BY-SA 4.0",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Argent",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Argent-Setup-${version}.${ext}"
    }
  }
}
